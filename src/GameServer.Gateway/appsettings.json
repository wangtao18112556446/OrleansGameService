{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=orleans_game;Username=game;Password=game",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "orleans-game",
    "Audience": "orleans-game-client",
    "SigningKey": "development-only-change-this-key-before-production-32-bytes",
    "AccessTokenLifetime": "08:00:00",
    "ClockSkew": "00:01:00"
  },
  "Orleans": {
    "UseAdoNet": true,
    "ClusterId": "orleans-game",
    "ServiceId": "orleans-game"
  },
  "GameServer": {
    "Realtime": {
      "MaxMessageBytes": 65536,
      "ReceiveBufferBytes": 8192
    },
    "RateLimit": {
      "PermitLimit": 120,
      "Window": "00:01:00"
    },
    "Content": {
      "BootstrapPath": "Content/game-content.v1.json",
      "AllowBuiltInFallback": false
    }
  },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  }
}
